        "GENERATE_INFOPLIST_FILE": "YES",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "mfsaglam.oqloqUITests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_TARGET_NAME": "oqloq",
      },
    }, {
      "name": "oqloqWidgetExtension",
      "id": "126E59342D062576005BC718",
      "product": "Products/oqloqWidgetExtension.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
