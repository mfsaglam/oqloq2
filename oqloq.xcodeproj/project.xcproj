  "targets": [
    {
      "name": "oqloq",
      "id": "E68577B72C45308000A95283",
      "product": "Products/oqloq.app",
      "product-type": "application",
      "dependencies": [
        "oqloqWidgetExtension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES": "YES",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "oqloq/oqloq.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_ASSET_PATHS": "\"oqloq/Preview Content\"",
        "DEVELOPMENT_TEAM": "RPQ3VF2JBZ",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "2.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "mfsaglam.routineClock",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "oqloqTests",
      "id": "E68577C72C45308200A95283",
      "product": "Products/oqloqTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "oqloq",
      "dependencies": [
        "oqloq",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES": "YES",
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "QNNWN5YKMZ",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "17.5",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "mfsaglam.oqloqTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/oqloq.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/oqloq",
      },
    }, {
      "name": "oqloqUITests",
      "id": "E68577D12C45308200A95283",
      "product": "Products/oqloqUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "oqloq",
